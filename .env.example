# Copy this file to .env and fill in real values.
# Required at startup - the server will refuse to boot without these:

DB_USER=
DB_PASSWORD=
ACCESS_TOKEN=
# Full Firebase service-account JSON, as a single-line string.
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional (sensible defaults are used if omitted):
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Optional - error monitoring. Leave blank to run without it.
# Get a free DSN at https://sentry.io (create a Node/Express project).
SENTRY_DSN=

# bKash Tokenized Checkout - required for any real payment to work.
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live:    https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Optional - transactional emails (booking confirmed, cash payment
# pending, new message). Leave blank to run without them; the server
# logs a one-time warning and simply skips sending instead of failing.
# Any standard SMTP provider works (Gmail app password, SendGrid,
# Mailgun, Amazon SES, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BuyTop <no-reply@buytop.app>

# Optional - AI companion (shopping assistant, support/FAQ bot, seller
# listing helper). Without this, /ai/* routes respond with a clear
# "not configured" message instead of the feature working. Runs on Groq,
# which has a genuinely free tier (no credit card, just a rate limit) -
# get a key in about 30 seconds at https://console.groq.com/keys
GROQ_API_KEY=
